# Lupus Ex Machina — runtime configuration.
#
# Copy to .env for local development. Every variable is optional: the defaults
# below are the ones the application applies on its own.
# In production, set these through the platform, never in the image.

# --- Server ---------------------------------------------------------------
# Interface to bind. Use 0.0.0.0 inside a container, 127.0.0.1 on a workstation.
LUPUS_HOST=127.0.0.1
# TCP port to listen on. Coolify injects its own value.
LUPUS_PORT=8000
# critical | error | warning | info | debug | trace
LUPUS_LOG_LEVEL=info

# --- Access ---------------------------------------------------------------
# Password the application is behind. Leave it empty and nobody gets in at all:
# forgetting to set one must shut the door, never open it. It is kept in the
# clear on purpose — there is one user, and whoever runs the server already
# holds the secret; hashing would move it without protecting it.
LUPUS_PASSWORD=
# Key the session cookie is signed with. Left empty, one is drawn at start-up,
# which logs everyone out whenever the server restarts. Set it to stay logged in
# across restarts — any long random string will do.
LUPUS_SECRET_KEY=

# --- Language models ------------------------------------------------------
# Key of the OpenAI-compatible provider. Without it, `make play-llm` refuses to
# start and the server plays scripted agents only. Never commit a real key: this
# file is the example, `.env` is ignored by git.
LUPUS_LLM_API_KEY=
# Endpoint of the provider. Mistral is consumed through its OpenAI-compatible
# API (D-043); any compatible endpoint works.
LUPUS_LLM_BASE_URL=https://api.mistral.ai/v1

# --- Paths ----------------------------------------------------------------
# Built front end. Defaults to <repository>/frontend/dist; the image sets
# /app/frontend/dist. Serving the UI is skipped when the directory is missing.
#LUPUS_FRONTEND_DIST=/app/frontend/dist
# GLB models exposed under /models. Defaults to <repository>/assets; the image
# sets /app/assets.
#LUPUS_MODELS_DIR=/app/assets
